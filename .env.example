# ── Supabase (blog + newsletter + diagnostic) ──────────────────────────────
VITE_SUPABASE_URL="https://api.odocpilot.com"
VITE_SUPABASE_PROJECT_ID="xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_PUBLISHABLE_KEY="xxxxxxxx (clé anon publique)"

# ── App SaaS (destination des CTA essai/connexion) ─────────────────────────
VITE_APP_URL="https://app.odocpilot.com"

# ── Mesure d'audience Umami (chargée après consentement, HTTPS uniquement) ──
# ⚠️ L'URL DOIT être en HTTPS, sinon le script n'est PAS chargé (anti mixed-content).
# Servir l'instance Umami derrière un sous-domaine SSL, ex. https://analytics.odocpilot.com
# (reverse-proxy nginx + Let's Encrypt vers le conteneur Umami du VPS, port 3002).
# Tant que ce HTTPS n'existe pas, l'analytics reste inactif (volontaire).
VITE_UMAMI_SRC="https://analytics.odocpilot.com/script.js"
VITE_UMAMI_WEBSITE_ID="8d6ac049-8bbb-452a-a55f-d1ac8a838c76"
